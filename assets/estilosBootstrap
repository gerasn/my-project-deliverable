/* Estilos del home */
body {
    font-family: 'Lato', sans-serif;
    background-color: #f4f4f9; /* Gris claro y suave */
    color: #333; /* Mejor contraste con el fondo claro */
    transition: background-color 0.3s ease; /* Transición suave para cambios de fondo */
}

.bg-primary {
    --bs-primary-rgb: 103, 58, 183; /* Tu color morado */
    --bs-bg-opacity: 1; /* Opacidad completa */
    background-color: rgba(var(--bs-primary-rgb), var(--bs-bg-opacity)) !important;
}

.nav-link {
    font-size: 1.1rem;
    padding: 10px;
    transition: background-color 0.3s ease;
}

.nav-link:hover {
    background-color: #673ab7;
    color: white !important;
    border-radius: 5px;
}

.nav-link.text-danger:hover {
    background-color: #ff4141;
    color: white !important;
}

.main-content {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;/*/img*/
    justify-content: center;
    align-items: center;
    text-align: center;
    min-height: 100vh;
}

.background-image-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    min-height: 100vh;
    z-index: -1; /* Envía el fondo detrás del contenido */
    overflow: hidden; /* Evita recortes indeseados */
}

.background-image {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Ajusta la imagen para cubrir todo el contenedor */
}

.main-content .content-wrapper {
    position: relative;
    z-index: 1; /* Asegura que el contenido esté por encima de la imagen */
    background-color: rgba(0, 0, 0, 0.5);
    padding: 20px;
    border-radius: 10px;
    color: white;
}

.main-content h2, .main-content p {
    color: white;
}

.collapse {
    transition: height 0.3s ease;
}

#menuToggleBtn {
    background-color: #673ab7; /* Color del tema */
    color: white; /* Texto en blanco */
    font-weight: bold; /* Negrita */
    border: none; /* Sin borde */
    width: 100%; /* Opcional: ancho completo */
    text-align: center;
}

#menuToggleBtn:hover {
    background-color: #53299c; /* Un tono más oscuro al pasar el cursor */
    color: white;
}

c {
    display: none; /* Ocultar contenido principal cuando el menú está abierto */
}

.lead {
    color: white;
}

/* Ajuste para dispositivos móviles */
@media (max-width: 768px) {
    .main-content {
        height: auto;
        padding: 20px;
    }

    .main-content h2 {
        font-size: 1.5rem;
    }

    .main-content p {
        font-size: 1rem;
    }
}

/* Estilos del Formulario */
.form-body {
    background-color: #f7f7f7;  /*Fondo neutro para diferenciar del home */
}

.form-wrapper {
    width: 90%;
    max-width: 600px;
    margin: 50px auto;
    padding: 20px;
    background-color: #fff;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    border-radius: 8px;
}

.form-wrapper h1 {
    text-align: center;
    font-size: 1.8rem;
    color: #333;
    margin-bottom: 20px;
}

.form-wrapper label {
    font-size: 0.9rem;
    color: #555;
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
}

.form-wrapper input[type="text"], 
.form-wrapper input[type="number"], 
.form-wrapper textarea, 
.form-wrapper select {
    width: 100%;
    padding: 10px;
    margin-bottom: 15px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 0.9rem;
}

.form-wrapper input:focus, 
.form-wrapper textarea:focus, 
.form-wrapper select:focus {
    border-color: #673ab7;
    outline: none;
    box-shadow: 0 0 5px rgba(103, 58, 183, 0.5);
}

.form-wrapper button {
    width: 100%;
    padding: 10px;
    background-color: #673ab7;
    color: #fff;
    font-size: 1rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.form-wrapper button:hover {
    background-color: #512da8;
}

.form-wrapper textarea::placeholder,
.form-wrapper input::placeholder {
    color: #aaa;
    font-style: italic;
}

@media (max-width: 768px) {
    .form-wrapper {
        padding: 15px;
    }

    .form-wrapper h1 {
        font-size: 1.5rem;
    }
}

/* Estilos listar*/
.table {
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    border-radius: 10px;
    overflow: hidden;
    margin-left: auto; /* Centra la tabla a la izquierda */
    margin-right: auto; /* Centra la tabla a la derecha */
    width: 80%; /* Ajusta el ancho de la tabla, puedes cambiar el porcentaje según sea necesario */
    background-color: #f4f4f9; /* Gris claro y suave */
}

.listar-container .table thead th {
    background-color: #673ab7; /* Fondo morado */
    color: white; /* Texto blanco */
    border: 1px solid #ddd; /* Bordes ligeros */
}

.table-striped tbody tr:nth-of-type(odd) {
    background-color: #f9f9f9;
}

.table-hover tbody tr:hover {
    background-color: #f1f1f1;
}

.container h2 {
    color: #673ab7;
    text-align: center;
}

/* Agregar sombras a los textos importantes para destacarlos */

.listar-container h2 {
    color: #673ab7;
    text-align: center;
    text-shadow: 0px 2px 4px rgba(0, 0, 0, 0.2);
}

.h1, h2, h3, .container h2, .lead{
    text-shadow: 0px 2px 4px rgba(0, 0, 0, 0.2);
    color: rgb(147, 19, 227);
}
